# --- OpenAI ---
OPENAI_API_KEY=sk-...
LORELENS_CHAT_MODEL=gpt-4o
LORELENS_FAST_MODEL=gpt-4o-mini

# --- Embeddings: "openai" or "huggingface" ---
LORELENS_EMBEDDING_PROVIDER=openai
LORELENS_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
LORELENS_HF_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
LORELENS_EMBEDDING_CACHE_DIR=.cache/embeddings

# --- Pinecone ---
PINECONE_API_KEY=pcsk_...
LORELENS_PINECONE_INDEX=lorelens-docs
LORELENS_PINECONE_NAMESPACE=default
LORELENS_PINECONE_CLOUD=aws
LORELENS_PINECONE_REGION=us-east-1

# --- Chunking ---
LORELENS_CHUNK_STRATEGY=markdown   # markdown | code_aware | token
LORELENS_CHUNK_SIZE=512            # tokens
LORELENS_CHUNK_OVERLAP=64

# --- Retrieval ---
LORELENS_TOP_K=8
LORELENS_CANDIDATE_K=24
LORELENS_RERANK_ENABLED=false
LORELENS_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
LORELENS_RETRIEVAL_CACHE_TTL=300

# --- Agent ---
LORELENS_TOOL_MODE=local           # local | mcp
LORELENS_MAX_REWRITES=2
LORELENS_MAX_TOOL_CALLS=6

# --- LangFuse (optional; tracing is disabled when keys are missing) ---
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com
LORELENS_PROMPT_LABEL=production

# --- API ---
LORELENS_API_KEY=                  # if set, requests must send X-API-Key
LORELENS_LOG_LEVEL=INFO
